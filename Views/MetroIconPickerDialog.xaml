<Window x:Class="Win8StartScreen.Views.MetroIconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог значков Metro UI"
        Width="960" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#CCCCCC"
        FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        BorderBrush="#3E3E42" BorderThickness="1"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Titlebar -->
        <Grid Grid.Row="0" Background="#2D2D30">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="📁" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock Text="Каталог значков Metro UI (2000+ иконок по категориям + Пользовательский PNG)" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
            </StackPanel>
            <Button Content="✕" Width="40" Height="36" HorizontalAlignment="Right" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Cursor="Hand" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- Search Bar + Quick Actions -->
        <Grid Grid.Row="1" Background="#252526" Margin="0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Margin="10,8,8,8" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <TextBlock Text="🔍 Поиск значка..." Foreground="#777777" Margin="8,6,0,0" FontSize="11" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                             Padding="6,4" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Preset Scale Selector Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                <TextBlock Text="Размер значка:" Foreground="#AAAAAA" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"/>
                <Button Content="Мелкий (36px)" Tag="36" Click="PresetSize_Click" Background="#333337" Foreground="#CCCCCC" Padding="6,3" Margin="0,0,4,0" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Стандарт (64px)" Tag="64" Click="PresetSize_Click" Background="#007ACC" Foreground="White" Padding="6,3" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Крупный (96px)" Tag="96" Click="PresetSize_Click" Background="#333337" Foreground="#CCCCCC" Padding="6,3" Margin="0,0,4,0" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Огромный (128px)" Tag="128" Click="PresetSize_Click" Background="#333337" Foreground="#CCCCCC" Padding="6,3" Margin="0,0,4,0" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Во всю плитку (160px)" Tag="160" Click="PresetSize_Click" Background="#333337" Foreground="#CCCCCC" Padding="6,3" Margin="0,0,4,0" FontSize="10" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Custom PNG & Clipboard -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="🖼 Загрузить PNG..." Background="#0E639C" Foreground="White" FontWeight="SemiBold" Padding="10,5" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BrowseCustomFile_Click" ToolTip="Выбрать файл картинки на компьютере"/>
                <Button Content="📋 Вставить (Ctrl+V)" Background="#333337" Foreground="#CCCCCC" Padding="8,5" BorderThickness="1" BorderBrush="#3E3E42" Cursor="Hand" Click="PasteFromClipboard_Click" ToolTip="Вставить скопированную картинку из буфера"/>
            </StackPanel>
        </Grid>

        <!-- Main Body: Categories Sidebar + Icons Grid -->
        <Grid Grid.Row="2" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CATEGORY SIDEBAR -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="КАТЕГОРИИ ЗНАЧКОВ" FontWeight="SemiBold" FontSize="10" Foreground="#888888" Margin="12,10,12,6"/>
                    <ListBox x:Name="CategoriesListBox" SelectionChanged="CategoriesListBox_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Foreground="#CCCCCC"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="4,1" Padding="8,5">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#333337"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT ICONS GRID -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <!-- Category Header & Active Count -->
                    <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="12,6" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock x:Name="ActiveCategoryHeader" Text="Все категории" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CategoryCountText" Text="Загрузка..." HorizontalAlignment="Right" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable Icons Area -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                        <WrapPanel x:Name="IconsWrapPanel" ItemWidth="94" ItemHeight="94"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Выберите значок для плитки (двойной клик для быстрого применения)" Foreground="#888888" VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Применить значок" Width="140" Height="28" Background="#007ACC" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="Select_Click" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Отмена" Width="80" Height="28" Background="#333337" Foreground="#CCCCCC" BorderThickness="0" Click="Close_Click" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
