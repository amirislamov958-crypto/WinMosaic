                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RU" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Русский" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Russian (Россия)" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LangRuCheckMark" Grid.Column="2" Text="✓" FontSize="18" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="Visible"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- English -->
                        <Border x:Name="LangEnCard" Margin="0,0,0,12" Background="#222222" BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Button Click="SelectLangEn_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,12" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="EN" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="English" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="United States" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LangEnCheckMark" Grid.Column="2" Text="✓" FontSize="18" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3.6 ПОДМЕНЮ: АВТОЗАГРУЗКА -->
            <Grid x:Name="SettingsAutostartView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,36,28,16">
                    <Button Style="{StaticResource CircleNavButton}" Width="32" Height="32" Click="NavigateToSettingsMain_Click" Margin="0,0,14,0" ToolTip="Назад в Параметры">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <TextBlock x:Name="SettingsAutostartTitleText" Text="Автозагрузка" FontSize="26" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,10,28,30">
                        <TextBlock x:Name="SettingsAutostartSubtitleText" Text="Параметры запуска WinMosaic вместе с Windows" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <!-- Переключатель 1: Автозапуск с Windows -->
                        <Border x:Name="AutostartToggleCard" Margin="0,0,0,16" Background="#222222" BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Button Click="ToggleAutostart_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,14" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock x:Name="AutostartWindowsHeader" Text="АВТОЗАПУСК С WINDOWS" FontSize="11.5" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AutostartStatusText" Text="Включено" FontSize="16" FontFamily="{StaticResource SegoeRegular}" Foreground="#80FF80" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AutostartWindowsDesc" Text="Запускать оболочку начального экрана автоматически при входе в систему." FontSize="12" FontFamily="{StaticResource SegoeRegular}" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AutostartCheckMark" Grid.Column="1" Text="✓" FontSize="20" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="Visible"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Переключатель 2: Открывать Пуск при старте -->
                        <Border x:Name="BootToStartToggleCard" Margin="0,0,0,20" Background="#222222" BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Button Click="ToggleBootToStart_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,14" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock x:Name="AutostartBootToStartHeader" Text="ОТКРЫВАТЬ «ПУСК» ПРИ ВКЛЮЧЕНИИ ПК" FontSize="11.5" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="BootToStartStatusText" Text="Отключено" FontSize="16" FontFamily="{StaticResource SegoeRegular}" Foreground="#CCCCCC" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AutostartBootToStartDesc" Text="Сразу открывать начальный экран при загрузке системы (как в оригинальной Windows 8.1)." FontSize="12" FontFamily="{StaticResource SegoeRegular}" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BootToStartCheckMark" Grid.Column="1" Text="✓" FontSize="20" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#282828" Margin="0,0,0,16"/>

                        <!-- Информационная плашка -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="СВЕДЕНИЯ О РЕГИСТРАЦИИ" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,6"/>
                            <TextBlock x:Name="AutostartLocationText" Text="HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WinMosaic" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AutostartExePathText" Text="WinMosaic.exe" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3.7 ПОДМЕНЮ: ОСНОВАТЕЛИ (ТИТРЫ / CREDITS) -->
            <Grid x:Name="SettingsFoundersView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,36,28,16">
                    <Button Style="{StaticResource CircleNavButton}" Width="32" Height="32" Click="NavigateToSettingsMain_Click" Margin="0,0,14,0" ToolTip="Назад в Параметры">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <TextBlock x:Name="SettingsFoundersTitleText" Text="Основатели" FontSize="26" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Титры: просто текст и всё -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,14,32,32">
                        <!-- Блок 1: ПЕТЯ -->
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock x:Name="SettingsFoundersLeadRoleText" Text="СОЗДАТЕЛЬ ПРОЕКТА" FontSize="11.5" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" VerticalAlignment="Center" Background="#111111">
                                    <Border.Clip>
                                        <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                                    </Border.Clip>
                                    <Image Source="/Assets/petya_mask.png" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="ПЕТЯ" FontSize="22" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SettingsFoundersLeadBioText" Text="Создал в одиночку by ПЕТЯ" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="#FFA500"/>
                        </StackPanel>

                        <!-- Блок 2: ChaosMaster - Studio® -->
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock x:Name="SettingsFoundersStudioRoleText" Text="СТУДИЯ РАЗРАБОТКИ" FontSize="11.5" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="30" Height="30" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center" Background="#111111">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,30,30" RadiusX="5" RadiusY="5"/>
                                    </Border.Clip>
                                    <Image Source="/Assets/chaosmaster_cube.jpg" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="ChaosMaster - Studio®" FontSize="20" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="SettingsFoundersStudioBioText" Text="Создано студией ChaosMaster - Studio®" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="#FF6666"/>
                        </StackPanel>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#282828" Margin="0,0,0,20"/>

                        <!-- Блок 3: О проекте / Манифест -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock x:Name="SettingsFoundersAboutHeader" Text="О ПРОЕКТЕ" FontSize="11.5" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SettingsFoundersTaglineText" Text="Всё, что создано в этом проекте — создано студией ChaosMaster - Studio® и создал в одиночку by ПЕТЯ." FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="White" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,12"/>
                            <TextBlock x:Name="SettingsFoundersDescText" Text="WinMosaic — воссоздание легендарного начального экрана Windows 8.1 для Windows 10 и Windows 11 со всеми эффектами, живыми плитками и поддержкой нескольких мониторов." FontSize="12" FontFamily="{StaticResource SegoeRegular}" Foreground="#888888" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#282828" Margin="0,0,0,16"/>

                        <!-- Финальный копирайт -->
                        <TextBlock Text="WinMosaic Shell • Версия 1.0 (Release)" FontSize="11" Foreground="#666666" Margin="0,0,0,3"/>
                        <TextBlock x:Name="SettingsFoundersCopyrightText" Text="© 2026 by ПЕТЯ &amp; ChaosMaster - Studio®" FontSize="11" Foreground="#555555"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- 4. ВЫДВИЖНАЯ ПАНЕЛЬ ПОИСКА (SEARCH CHARM) WINDOWS 8.1          -->
        <!-- ============================================================== -->
        <Grid x:Name="SearchCharmFlyout" Width="340" HorizontalAlignment="Right" Background="#FF0A0A0A" Panel.ZIndex="100" Margin="0,0,-340,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SearchCharmTranslate" X="0"/>
            </Grid.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER & INPUT AREA (Padding: 38,36,38,14) -->
                <StackPanel Grid.Row="0" Margin="38,36,38,14">
                    <!-- Заголовок «Поиск» -->
                    <TextBlock Text="Поиск" FontSize="30" FontFamily="{StaticResource SegoeLight}" Foreground="White" Margin="0,0,0,10"/>

                    <!-- Выбор области поиска («Везде ⌵») -->
                    <Button x:Name="SearchScopeButton" Click="SearchScopeButton_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0" Cursor="Hand" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SearchScopeText" Text="Везде" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="White" Margin="0,0,6,0"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Поле ввода с акцентной кнопкой лупы -->
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White">
                            <Grid>
                                <!-- Инлайн-автокомплит Windows 8.1 (белый текст на акцентном фоне) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0" IsHitTestVisible="False">
                                    <TextBlock x:Name="SearchQueryPrefixGhost" Text="" FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="Transparent"/>
                                    <Border x:Name="SearchAutocompleteBadge" Background="{DynamicResource ThemeAccentBrush}" Padding="1,0,3,0" Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBlock x:Name="SearchAutocompleteText" Text="" FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <TextBox x:Name="SearchQueryInput" 
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         Foreground="Black" 
                                         CaretBrush="Black" 
                                         FontSize="14" 
                                         FontFamily="{StaticResource SegoeRegular}" 
                                         VerticalContentAlignment="Center" 
                                         Padding="8,0,4,0" 
                                         TextChanged="SearchQueryInput_TextChanged"
                                         PreviewKeyDown="SearchQueryInput_PreviewKeyDown"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Click="SearchButton_Click" Background="{DynamicResource ThemeAccentBrush}" BorderThickness="0" Cursor="Hand" ToolTip="Найти">
                            <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Fill="White" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- СПИСОК РЕЗУЛЬТАТОВ (ПОЛНАЯ ШИРИНА ВО ВСЮ ПАНЕЛЬ) -->
                <ListBox Grid.Row="1" x:Name="SearchResultsListBox" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Padding="0" 
                         Margin="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         SelectionChanged="SearchResultsListBox_SelectionChanged"
                         MouseLeftButtonUp="SearchResultsListBox_MouseLeftButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="MinHeight" Value="54"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" MinHeight="54">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#222222"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="54">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Квадратная иконка приложения / параметра (ровно на x=38px) -->
                                <Border Grid.Column="0" Width="38" Height="38" Background="{Binding TileBrush}" HorizontalAlignment="Left" Margin="38,0,0,0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding IconImagePath}" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIconImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <Path Data="{Binding IconVectorPath}" Fill="White" Stretch="Uniform" Width="22" Height="22">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasIconImage}" Value="False"/>
                                                                <Condition Binding="{Binding HasVectorPath}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>

                                        <TextBlock Text="{Binding IconGlyph}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasIconImage}" Value="False"/>
                                                                <Condition Binding="{Binding HasVectorPath}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Название результата поиска -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="White" VerticalAlignment="Center" Margin="12,0,16,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ПОДВАЛ: РАЗДЕЛИТЕЛЬ И ПОИСКОВЫЙ ЗАПРОС -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Rectangle x:Name="SearchDivider" Height="1" Fill="#282828" Margin="38,8,38,12" Visibility="Collapsed"/>
                    <Button x:Name="SearchQuerySuggestionButton" Click="SearchQuerySuggestion_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" Padding="38,6,38,6" Visibility="Collapsed">
                        <TextBlock x:Name="SearchQuerySuggestionText" Text="" FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="White" HorizontalAlignment="Left"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- 6. ВСПЛЫВАЮЩИЕ METRO-FLYOUTS (USER & POWER)                    -->
        <!-- ============================================================== -->
        <Border x:Name="UserFlyout" Width="210" Background="{DynamicResource ThemeBackgroundPrimary}" BorderBrush="#55FFFFFF" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Collapsed" Panel.ZIndex="10000">
            <StackPanel>
                <Button x:Name="UserPersonalizeBtn" Style="{StaticResource MetroMenuButton}" Content="Персонализация" Click="OpenPersonalizeFromUser_Click"/>
                <Button x:Name="UserChangeAvatarBtn" Style="{StaticResource MetroMenuButton}" Content="Сменить аватар" Click="ChangeAvatar_Click"/>
                <Button x:Name="UserLockBtn" Style="{StaticResource MetroMenuButton}" Content="Заблокировать" Click="LockSystem_Click"/>
                <Button x:Name="UserSignOutBtn" Style="{StaticResource MetroMenuButton}" Content="Выйти" Click="LogoffSystem_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="PowerFlyout" Width="210" Background="{DynamicResource ThemeBackgroundPrimary}" BorderBrush="#55FFFFFF" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" Visibility="Collapsed" Panel.ZIndex="10000">
            <StackPanel>
                <Button x:Name="PowerSleepBtn" Style="{StaticResource MetroMenuButton}" Content="Спящий режим" Click="SleepSystem_Click"/>
                <Button x:Name="PowerShutdownBtn" Style="{StaticResource MetroMenuButton}" Content="Завершение работы" Click="ShutdownSystem_Click"/>
                <Button x:Name="PowerRestartBtn" Style="{StaticResource MetroMenuButton}" Content="Перезагрузка" Click="RestartSystem_Click"/>
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- 7. ПЛАВАЮЩИЙ HUD ИНСТРУМЕНТА «ПИПЕТКА» (EYEDROPPER)            -->
        <!-- ============================================================== -->
        <Border x:Name="EyedropperHud" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Background="#EE1E1E1E" BorderBrush="#00A4EF" BorderThickness="2" CornerRadius="6" Padding="14,10" Visibility="Collapsed" Panel.ZIndex="9999">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="EyedropperSwatch" Width="36" Height="36" Background="#FF0078D7" CornerRadius="4" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EyedropperHexText" Text="#FF0078D7" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                        <TextBlock x:Name="EyedropperRgbText" Text=" (RGB: 0, 120, 215)" Foreground="#AAAAAA" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Кликните ЛКМ для взятия цвета • Esc для отмены" Foreground="#00A4EF" FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
