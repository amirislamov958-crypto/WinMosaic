            </Grid>

            <!-- 3.2 ПОДМЕНЮ: ПЕРСОНАЛИЗАЦИЯ -->
            <Grid x:Name="SettingsPersonalizeView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,36,28,16">
                    <Button Style="{StaticResource CircleNavButton}" Width="32" Height="32" Click="NavigateToSettingsMain_Click" Margin="0,0,14,0" ToolTip="Назад в Параметры">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <TextBlock Text="Персонализация" FontSize="26" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,10,28,30">
                        <!-- Выбор узоров -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Фоновый узор" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="PatternsWrapPanel" Width="304"/>
                        </StackPanel>

                        <!-- ПОЛЬЗОВАТЕЛЬСКИЕ ОБОИ -->
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="Фоновое изображение" FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="UploadWallpaperButton" Content="📁 Выбрать обои..." Click="UploadWallpaper_Click"
                                        Background="#33FFFFFF" Foreground="White" BorderBrush="White" BorderThickness="1"
                                        Padding="14,7" FontSize="12" FontFamily="{StaticResource SegoeRegular}" Cursor="Hand"/>
                                <Button x:Name="ResetWallpaperButton" Content="Сбросить" Click="ResetWallpaper_Click"
                                        Background="Transparent" Foreground="#BBFFFFFF" BorderThickness="0"
                                        Margin="10,0,0,0" Padding="8,7" FontSize="12" FontFamily="{StaticResource SegoeRegular}" Cursor="Hand" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Ползунок черноватого оттенка / затемнения -->
                            <StackPanel x:Name="WallpaperDarknessContainer" Margin="0,2,0,0" Visibility="Collapsed">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Черноватый оттенок (затемнение)" FontSize="12" Foreground="#CCFFFFFF"/>
                                    <TextBlock x:Name="DarknessValueTextBlock" Text="45%" FontSize="12" Foreground="#88FFFFFF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="WallpaperDarknessSlider" Minimum="0.1" Maximum="0.85" SmallChange="0.05" LargeChange="0.1" Value="0.45"
                                        ValueChanged="WallpaperDarknessSlider_ValueChanged" Width="288" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ЦВЕТОВАЯ ТЕМА (МЕНЯЕТ ЛИНИЮ) -->
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="Цветовая тема" FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                            <UniformGrid x:Name="ThemeShadesGrid" Rows="2" Columns="6" Width="288" Height="72" HorizontalAlignment="Left"/>
                            <StackPanel x:Name="HueSliderPanel" Orientation="Horizontal" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Палитра фона -->
                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="Цвет фона" FontSize="14" FontFamily="{StaticResource SegoeRegular}" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                            <UniformGrid x:Name="BgShadesGrid" Rows="3" Columns="6" Width="288" Height="108" HorizontalAlignment="Left"/>
                            <StackPanel x:Name="BgHueSliderPanel" Orientation="Horizontal" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Палитра акцента -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Цвет элементов (Акцент)" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="AccentColorsWrapPanel" Width="304"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3.3 ПОДМЕНЮ: ДОБАВИТЬ СВОЮ ПЛИТКУ -->
            <Grid x:Name="SettingsAddTileView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,36,28,16">
                    <Button Style="{StaticResource CircleNavButton}" Width="32" Height="32" Click="NavigateToSettingsMain_Click" Margin="0,0,14,0" ToolTip="Назад в Параметры">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <TextBlock Text="Добавить плитку" FontSize="26" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,30">
                        <!-- 1. LIVE PREVIEW (Предпросмотр создаваемой плитки) -->
                        <TextBlock Text="Предварительный просмотр" FontSize="12.5" Foreground="#A0FFFFFF" Margin="0,0,0,8"/>
                        <Border Background="#181818" Padding="14" Margin="0,0,0,16" HorizontalAlignment="Left" Width="304">
                            <Grid HorizontalAlignment="Center">
                                <Border x:Name="TilePreviewBox" Width="150" Height="150" Background="#FF0078D7" ClipToBounds="True">
                                    <Grid>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="TilePreviewImage" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                            <Path x:Name="TilePreviewVector" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="44" Height="44" Stretch="Uniform" Visibility="Visible"/>
                                            <TextBlock x:Name="TilePreviewGlyph" Text="★" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock x:Name="TilePreviewTitle" Text="Моя плитка" FontSize="12" FontFamily="{StaticResource SegoeRegular}" Foreground="White" VerticalAlignment="Bottom" Margin="10,0,8,8" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. НАЗВАНИЕ ПЛИТКИ -->
                        <TextBlock Text="Название плитки" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,6"/>
                        <TextBox x:Name="AddTileTitleInput" Height="30" Background="White" Foreground="Black" CaretBrush="Black" BorderThickness="0" Padding="8,0" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" VerticalContentAlignment="Center" TextChanged="AddTileInputs_Changed"/>

                        <!-- 3. ПУТЬ К ПРИЛОЖЕНИЮ, ФАЙЛУ ИЛИ ССЫЛКЕ -->
                        <TextBlock Text="Приложение, файл или ссылка (URL)" FontSize="13" Foreground="#CCFFFFFF" Margin="0,14,0,6"/>
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddTilePathInput" Grid.Column="0" Background="White" Foreground="Black" CaretBrush="Black" BorderThickness="0" Padding="8,0" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" VerticalContentAlignment="Center" TextChanged="AddTileInputs_Changed" AllowDrop="True" PreviewDragOver="AddTilePathInput_PreviewDragOver" Drop="AddTilePathInput_Drop" ToolTip="Введите путь к .exe, любому файлу или ссылку на сайт (например, https://youtube.com)"/>
                            <Button Grid.Column="1" Click="BrowseTileApp_Click" Content="Обзор..." Background="#3A3A3A" Foreground="White" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" FontSize="12.5" ToolTip="Выбрать локальное приложение или файл"/>
                        </Grid>

                        <!-- 4. РАЗМЕР ПЛИТКИ -->
                        <TextBlock Text="Размер плитки" FontSize="13" Foreground="#CCFFFFFF" Margin="0,14,0,6"/>
                        <UniformGrid x:Name="TileSizeSelectorGrid" Rows="1" Columns="4" Height="32">
                            <Button x:Name="SizeBtnSmall" Click="SelectTileSize_Click" Tag="Small" Content="70×70" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="0,0,3,0" Cursor="Hand" FontSize="11.5"/>
                            <Button x:Name="SizeBtnMedium" Click="SelectTileSize_Click" Tag="Medium" Content="150×150" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" BorderThickness="2" BorderBrush="White" Margin="2,0,2,0" Cursor="Hand" FontSize="11.5"/>
                            <Button x:Name="SizeBtnWide" Click="SelectTileSize_Click" Tag="Wide" Content="310×150" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="2,0,2,0" Cursor="Hand" FontSize="11.5"/>
                            <Button x:Name="SizeBtnLarge" Click="SelectTileSize_Click" Tag="Large" Content="310×310" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="3,0,0,0" Cursor="Hand" FontSize="11.5"/>
                        </UniformGrid>

                        <!-- 5. ЦВЕТ ПЛИТКИ И ПИПЕТКА -->
                        <TextBlock Text="Цвет фона плитки" FontSize="13" Foreground="#CCFFFFFF" Margin="0,14,0,6"/>
                        <Grid Margin="0,0,0,8" Width="304" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AddTileColorSwatch" Grid.Column="0" Width="26" Height="28" Background="#FF0078D7" BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="1"/>
                            <TextBox x:Name="AddTileColorHexInput" Grid.Column="1" Height="28" Background="White" Foreground="Black" CaretBrush="Black" BorderThickness="0" Padding="8,0" FontSize="13" FontFamily="{StaticResource SegoeRegular}" VerticalContentAlignment="Center" Margin="6,0,6,0" Text="#FF0078D7" TextChanged="AddTileColorHexInput_TextChanged"/>
                            <Button x:Name="AddTileEyedropperBtn" Grid.Column="2" Click="Eyedropper_Click" ToolTip="Инструмент «Пипетка»: взять цвет с любого окна или экрана" Background="#3A3A3A" Foreground="White" BorderThickness="0" Height="28" Cursor="Hand" FontSize="13">
                                <TextBlock Text="🧪" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <WrapPanel x:Name="AddTileColorsWrapPanel" Width="304" Margin="0,0,0,4"/>

                        <!-- 6. ИКОНКА / ЗНАЧОК -->
                        <TextBlock Text="Значок плитки" FontSize="13" Foreground="#CCFFFFFF" Margin="0,12,0,6"/>
                        <WrapPanel Width="304" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Button Click="OpenMetroIconCatalog_Click" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,6,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" Margin="0,0,6,0"/>
                                    <TextBlock Text="Каталог Metro (2000+)"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BrowseTileIcon_Click" Content="Выбрать файл..." Background="#3A3A3A" Foreground="White" BorderThickness="0" Padding="10,6" Margin="0,0,6,6" Cursor="Hand" FontSize="12"/>
                            <Button Click="ResetTileIcon_Click" Content="Сбросить" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" Padding="8,6" Margin="0,0,6,6" Cursor="Hand" FontSize="12"/>
                        </WrapPanel>

                        <!-- 7. МАСШТАБ И ПРИБЛИЖЕНИЕ PNG (ICON ZOOM) -->
                        <TextBlock Text="Масштаб и приближение значка" FontSize="13" Foreground="#CCFFFFFF" Margin="0,4,0,4"/>
                        <DockPanel Margin="0,0,0,6" Width="304" HorizontalAlignment="Left">
                            <TextBlock x:Name="AddTileIconSizeText" Text="64 px (100%)" Width="82" DockPanel.Dock="Right" TextAlignment="Right" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                            <Slider x:Name="AddTileIconSizeSlider" Minimum="24" Maximum="300" Value="64" SmallChange="4" LargeChange="16" ValueChanged="AddTileIconSizeSlider_ValueChanged" VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Width="304" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <Button Content="S (36px)" Tag="36" Click="AddTileIconPreset_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Padding="6,3" Margin="0,0,4,4" Cursor="Hand" FontSize="11"/>
                            <Button Content="M (64px)" Tag="64" Click="AddTileIconPreset_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Padding="6,3" Margin="0,0,4,4" Cursor="Hand" FontSize="11"/>
                            <Button Content="L (96px)" Tag="96" Click="AddTileIconPreset_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Padding="6,3" Margin="0,0,4,4" Cursor="Hand" FontSize="11"/>
                            <Button Content="XL (140px)" Tag="140" Click="AddTileIconPreset_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Padding="6,3" Margin="0,0,4,4" Cursor="Hand" FontSize="11"/>
                            <Button Content="MAX (Во всю)" Tag="MAX" Click="AddTileIconPreset_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Padding="6,3" Margin="0,0,4,4" Cursor="Hand" FontSize="11"/>
                            <Button Content="⟲ 100%" Tag="RESET" Click="AddTileIconPreset_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Padding="6,3" Margin="0,0,4,4" Cursor="Hand" FontSize="11"/>
                        </WrapPanel>

                        <!-- 7. КНОПКА ДОБАВЛЕНИЯ -->
                        <Button Click="CreateCustomTile_Click" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" BorderThickness="0" Height="42" Margin="0,22,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить на экран «Пуск»" FontSize="14" FontFamily="{StaticResource SegoeRegular}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Сообщение о статусе -->
                        <TextBlock x:Name="AddTileStatusMessage" Text="" Visibility="Collapsed" Margin="0,12,0,0" FontSize="13" Foreground="#80FF80" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3.3 ВНУТРЕННИЙ ВИД: РЕДАКТОР ЭКРАНА (STUDIO) - РАЗМЕР И ПЕРЕМЕЩЕНИЕ ПЛИТОК -->
            <Grid x:Name="SettingsStudioView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,36,28,16">
                    <Button Style="{StaticResource CircleNavButton}" Width="32" Height="32" Click="NavigateToSettingsMain_Click" Margin="0,0,14,0" ToolTip="Назад в Параметры">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <TextBlock Text="Редактор плиток" FontSize="26" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,6,28,30">
                        <!-- 1. ВЫБОР ПЛИТКИ -->
                        <TextBlock Text="Выберите плитку для настройки" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,6"/>
                        <ComboBox x:Name="StudioTileSelector" Height="34" Margin="0,0,0,14" SelectionChanged="StudioTileSelector_SelectionChanged" Background="#FF282828" Foreground="White" BorderBrush="#55FFFFFF" BorderThickness="1" FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,2">
                                        <Border Width="14" Height="14" Background="{Binding BackgroundColor}" Margin="0,0,8,0" VerticalAlignment="Center" CornerRadius="1"/>
                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Инфо о выбранной плитке -->
                        <Border x:Name="StudioTileInfoCard" Background="#181818" Padding="12" Margin="0,0,0,16" HorizontalAlignment="Left" Width="304">
                            <StackPanel>
                                <TextBlock x:Name="StudioTileTitleText" Text="Плитка не выбрана" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StudioTileDetailsText" Text="Размер: -, Позиция: -" FontSize="12" Foreground="#AAAAAA"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. ИЗМЕНИТЬ РАЗМЕР ПЛИТКИ (УМЕНЬШАТЬ И УВЕЛИЧИВАТЬ) -->
                        <TextBlock Text="Размер плитки (уменьшить / увеличить)" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,6"/>
                        <UniformGrid Rows="2" Columns="2" Height="74" Margin="0,0,0,16" Width="304" HorizontalAlignment="Left">
                            <Button x:Name="StudioSizeSmallBtn" Content="◽ Мелкий (71×71)" Tag="Small" Click="StudioSize_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="0,0,4,4" Cursor="Hand" FontSize="11.5"/>
                            <Button x:Name="StudioSizeMediumBtn" Content="◻ Средний (150×150)" Tag="Medium" Click="StudioSize_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="0,0,0,4" Cursor="Hand" FontSize="11.5"/>
                            <Button x:Name="StudioSizeWideBtn" Content="▭ Широкий (308×150)" Tag="Wide" Click="StudioSize_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="0,0,4,0" Cursor="Hand" FontSize="11.5"/>
                            <Button x:Name="StudioSizeLargeBtn" Content="◼ Большой (308×308)" Tag="Large" Click="StudioSize_Click" Background="#262626" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Margin="0,0,0,0" Cursor="Hand" FontSize="11.5"/>
                        </UniformGrid>

                        <!-- 3. ПЕРЕДВИЖЕНИЕ ПЛИТКИ (ПЕРЕДВИГАТЬ) -->
                        <TextBlock Text="Передвижение плитки" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,6"/>
                        <Grid Width="304" Height="120" Margin="0,0,0,16" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Вверх -->
                            <Button Grid.Row="0" Grid.Column="1" Click="StudioMoveUp_Click" Content="▲ Вверх" Background="#2A2A2A" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Cursor="Hand" Margin="2" FontSize="12"/>
                            <!-- Влево -->
                            <Button Grid.Row="1" Grid.Column="0" Click="StudioMoveLeft_Click" Content="◀ Влево" Background="#2A2A2A" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Cursor="Hand" Margin="2" FontSize="12"/>
                            <!-- Поменять со следующей -->
                            <Button Grid.Row="1" Grid.Column="1" Click="StudioSwapNext_Click" Content="⇄ Обмен" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" BorderThickness="1" BorderBrush="#80FFFFFF" Cursor="Hand" Margin="2" FontSize="12" ToolTip="Поменять местами со следующей плиткой"/>
                            <!-- Вправо -->
                            <Button Grid.Row="1" Grid.Column="2" Click="StudioMoveRight_Click" Content="Вправо ▶" Background="#2A2A2A" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Cursor="Hand" Margin="2" FontSize="12"/>
                            <!-- Вниз -->
                            <Button Grid.Row="2" Grid.Column="1" Click="StudioMoveDown_Click" Content="▼ Вниз" Background="#2A2A2A" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Cursor="Hand" Margin="2" FontSize="12"/>
                        </Grid>

                        <!-- 4. ДЕЙСТВИЯ -->
                        <TextBlock Text="Действия" FontSize="13" Foreground="#CCFFFFFF" Margin="0,0,0,6"/>
                        <Button Click="StudioToggleLiveTile_Click" Background="#2A2A2A" Foreground="White" BorderThickness="1" BorderBrush="#50FFFFFF" Height="36" Margin="0,0,0,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⟳ Переключить живую плитку" FontSize="13" FontFamily="{StaticResource SegoeRegular}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="StudioUnpinTile_Click" Background="#A0800000" Foreground="White" BorderThickness="1" BorderBrush="#A0FF4444" Height="36" Margin="0,0,0,8" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✕ Открепить выбранную плитку" FontSize="13" FontFamily="{StaticResource SegoeRegular}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="StudioStatusMessage" Text="" Visibility="Collapsed" Margin="0,8,0,0" FontSize="12.5" Foreground="#80FF80" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 3.4 ПОДМЕНЮ: ЭКРАНЫ И МОНИТОРЫ -->
            <Grid x:Name="SettingsMonitorsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,36,28,16">
                    <Button Style="{StaticResource CircleNavButton}" Width="32" Height="32" Click="NavigateToSettingsMain_Click" Margin="0,0,14,0" ToolTip="Назад в Параметры">
                        <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                    <TextBlock x:Name="SettingsMonitorsTitleText" Text="Экраны" FontSize="26" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,10,28,30">
                        <TextBlock x:Name="SettingsMonitorsSubtitleText" Text="Выберите монитор для начального экрана:" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Кнопка: Основной монитор -->
                        <Border x:Name="PrimaryMonitorCard" Margin="0,0,0,12" Background="#222222" BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Button Click="SelectPrimaryMonitor_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,12" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z" 
                                          Fill="White" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="PrimaryMonitorTitleText" Text="Основной монитор" FontSize="14.5" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock x:Name="PrimaryMonitorDetailsText" Text="2560 × 1440" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PrimaryMonitorCheckMark" Grid.Column="2" Text="✓" FontSize="18" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="Visible"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Кнопка: Второй монитор -->
                        <Border x:Name="SecondaryMonitorCard" Margin="0,0,0,16" Background="#222222" BorderThickness="1" BorderBrush="#40FFFFFF">
                            <Button x:Name="SecondaryMonitorButton" Click="SelectSecondaryMonitor_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="14,12" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z" 
                                          Fill="White" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="SecondaryMonitorTitleText" Text="Второй монитор" FontSize="14.5" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock x:Name="SecondaryMonitorDetailsText" Text="1920 × 1080" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SecondaryMonitorCheckMark" Grid.Column="2" Text="✓" FontSize="18" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- УВЕДОМЛЕНИЕ: Если второго монитора нет -->
                        <Border x:Name="NoSecondMonitorNotice" Background="#2E1C05" BorderBrush="#A0FF9900" BorderThickness="1" Padding="14,12" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="18" Foreground="#FFA500" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="NoSecondMonitorText" Text="Второй монитор не обнаружен. Подключите дополнительный дисплей для отображения начального экрана на нём." FontSize="12.5" FontFamily="{StaticResource SegoeRegular}" Foreground="#E0E0E0" TextWrapping="Wrap" Width="240"/>
                            </StackPanel>
