<Window x:Class="Win8StartScreen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Win8StartScreen"
        Title="WinMosaic"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeBackgroundPrimary}"
        Focusable="True"
        Visibility="Hidden"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid x:Name="RootLayout" ClipToBounds="True" Background="Transparent" MouseRightButtonUp="RootLayout_MouseRightButtonUp" PreviewMouseDown="RootLayout_PreviewMouseDown">
        
        <!-- ДИНАМИЧЕСКИЙ ФОН WINDOWS 8.1 (ЧИСТЫЙ ГРАДИЕНТ ТЕМЫ ИЛИ СВОИ ОБОИ С ЗАТЕМНЕНИЕМ) -->
        <Grid x:Name="WallpaperCanvas" IsHitTestVisible="False">
            <!-- Градиентная подложка по умолчанию -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="GradStop1" Color="{Binding Source={StaticResource ThemeBackgroundPrimary}, Path=Color}" Offset="0.0"/>
                    <GradientStop x:Name="GradStop2" Color="{Binding Source={StaticResource ThemeBackgroundSecondary}, Path=Color}" Offset="0.5"/>
                    <GradientStop x:Name="GradStop3" Color="{Binding Source={StaticResource ThemeBackgroundPrimary}, Path=Color}" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Пользовательские обои -->
            <Image x:Name="CustomWallpaperImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
            <!-- Черноватый полупрозрачный оттенок поверх обоев для сохранения читаемости плиток и интерфейса -->
            <Rectangle x:Name="CustomWallpaperDarkTint" Fill="#000000" Opacity="0.45" Visibility="Collapsed"/>
        </Grid>

        <!-- Фоновые аутентичные ленты и волны Windows 8.1 (ТОЛЬКО ДЛЯ ЭКРАНА ПУСК) -->
        <Viewbox x:Name="RibbonContainer" Stretch="Fill" IsHitTestVisible="False">
            <Viewbox.RenderTransform>
                <TranslateTransform x:Name="RibbonTranslate" X="0" Y="0"/>
            </Viewbox.RenderTransform>
            <Canvas Width="1920" Height="1080" ClipToBounds="True">
                <Canvas x:Name="RibbonCanvas" Canvas.Left="720" Canvas.Top="0" Width="550" Height="547">
                        <Canvas.RenderTransform>
                            <ScaleTransform ScaleX="1.9744" ScaleY="1.9744"/>
                        </Canvas.RenderTransform>

                        <!-- 0. BASE CONTINUOUS SILK UNDERLAY -->
                        <Path Data="M 0,0 C 20,80 85,175 162,250 C 175,300 179,380 178,430 C 175,470 195,510 250,547 L 540,547 C 495,490 425,410 330,315 C 275,275 253,210 255,180 C 255,140 280,50 350,0 Z"
                              Opacity="0.85">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                                    <GradientStop x:Name="BaseStop1" Color="#FF401B78" Offset="0.0"/>
                                    <GradientStop x:Name="BaseStop2" Color="#FF602FCE" Offset="0.25"/>
                                    <GradientStop x:Name="BaseStop3" Color="#FF401B78" Offset="0.5"/>
                                    <GradientStop x:Name="BaseStop4" Color="#FF200D3D" Offset="0.75"/>
                                    <GradientStop x:Name="BaseStop5" Color="#00200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Lower Right Translucent Ambient Veil -->
                        <Path Data="M 272,250 C 330,315 400,380 470,450 C 510,490 535,525 550,547 L 480,547 C 430,485 370,420 310,350 C 275,305 270,275 272,250 Z"
                              Opacity="0.45">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="VeilStop1" Color="#80401B78" Offset="0.0"/>
                                    <GradientStop x:Name="VeilStop2" Color="#50200D3D" Offset="0.5"/>
                                    <GradientStop x:Name="VeilStop3" Color="#00200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- 1. BAND 1: CONTINUOUS FLOWING LEFT SILK DRAPE (Top to Bottom) -->
                        <Path Data="M 0,0 C 20,80 85,175 162,250 C 172,285 178,340 178,400 C 178,445 175,475 195,510 C 215,535 235,547 250,547 L 290,547 C 240,520 215,465 210,400 C 205,340 190,285 177,245 C 115,160 70,70 68,0 Z"
                              Opacity="0.92">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.7,1">
                                    <GradientStop x:Name="B1Stop1" Color="#FF401B78" Offset="0.0"/>
                                    <GradientStop x:Name="B1Stop2" Color="#FF602FCE" Offset="0.3"/>
                                    <GradientStop x:Name="B1Stop3" Color="#FF401B78" Offset="0.6"/>
                                    <GradientStop x:Name="B1Stop4" Color="#00200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- 2. UPPER BANDS: 2, 3, 4 -->
                        <!-- Upper Band 2 -->
                        <Path Data="M 68,0 C 70,70 115,160 177,245 L 220,255 C 165,165 144,75 150,0 Z"
                              Opacity="0.95">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop x:Name="B2Stop1" Color="#FF602FCE" Offset="0.0"/>
                                    <GradientStop x:Name="B2Stop2" Color="#FF401B78" Offset="0.45"/>
                                    <GradientStop x:Name="B2Stop3" Color="#FF200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Upper Band 3 (Center Glowing Drape) -->
                        <Path x:Name="PatternPath1" Data="M 150,0 C 144,75 165,165 220,255 L 255,260 C 228,160 238,65 255,0 Z"
                              Opacity="0.98">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                                    <GradientStop x:Name="B3Stop1" Color="#FFA46AFF" Offset="0.0"/>
                                    <GradientStop x:Name="B3Stop2" Color="#FF602FCE" Offset="0.55"/>
                                    <GradientStop x:Name="B3Stop3" Color="#FF401B78" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Upper Band 4 (Right Shadow Drape) -->
                        <Path Data="M 255,0 C 238,65 228,160 255,260 L 278,265 C 245,140 280,50 350,0 Z"
                              Opacity="0.80">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="B4Stop1" Color="#FF401B78" Offset="0.0"/>
                                    <GradientStop x:Name="B4Stop2" Color="#FF200D3D" Offset="0.55"/>
                                    <GradientStop x:Name="B4Stop3" Color="#00200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- 3. LOWER SECTION: CASCADING VERTICAL DRAPES & PETALS -->
                        <!-- Lower Flowing Petal 2 -->
                        <Path Data="M 215,252 C 260,275 300,295 330,315 C 380,365 435,420 475,480 C 505,520 525,540 535,547 L 450,547 C 415,485 365,425 315,370 C 270,320 240,285 215,252 Z"
                              Opacity="0.82">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop x:Name="LP2Stop1" Color="#95602FCE" Offset="0.0"/>
                                    <GradientStop x:Name="LP2Stop2" Color="#95401B78" Offset="0.35"/>
                                    <GradientStop x:Name="LP2Stop3" Color="#50200D3D" Offset="0.75"/>
                                    <GradientStop x:Name="LP2Stop4" Color="#00200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Lower Glowing Petal 1: Continuous cascade from under the crease -->
                        <Path x:Name="PatternPath2" Data="M 155,220 C 190,235 225,248 255,260 C 285,275 315,295 330,315 C 380,365 435,425 475,485 C 500,520 512,538 518,547 L 430,547 C 390,485 340,420 280,360 C 235,305 185,260 155,220 Z"
                              Opacity="0.92">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop x:Name="LP1Stop1" Color="#E5A46AFF" Offset="0.0"/>
                                    <GradientStop x:Name="LP1Stop2" Color="#C5602FCE" Offset="0.3"/>
                                    <GradientStop x:Name="LP1Stop3" Color="#80401B78" Offset="0.7"/>
                                    <GradientStop x:Name="LP1Stop4" Color="#00200D3D" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- 4. SOFT FOLD SHADOW & CRISP LUMINOUS FOLD STROKE -->
                        <!-- Soft Under-Fold Shadow -->
                        <Path Data="M 155,220 C 190,235 225,248 255,260 C 285,275 315,295 330,315 L 320,335 C 285,310 245,285 210,265 C 175,245 158,230 155,220 Z"
                              Opacity="0.55">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#B0000000" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>

                        <!-- Crisp Luminous Fold Highlight Stroke -->
                        <Path Data="M 155,220 C 190,235 225,248 255,260 C 285,275 315,295 330,315"
                              StrokeThickness="3.2" Opacity="0.98">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="FoldStop1" Color="#00FFFFFF" Offset="0.0"/>
                                    <GradientStop x:Name="FoldStop2" Color="#C0A46AFF" Offset="0.15"/>
                                    <GradientStop x:Name="FoldStop3" Color="#FFFFFFFF" Offset="0.45"/>
                                    <GradientStop x:Name="FoldStop4" Color="#F0A46AFF" Offset="0.75"/>
                                    <GradientStop x:Name="FoldStop5" Color="#00FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                    </Canvas>
                </Canvas>
            </Viewbox>

        <!-- ============================================================== -->
        <!-- 1. ГЛАВНЫЙ ЭКРАН ПУСК (START SCREEN)                           -->
        <!-- ============================================================== -->
        <Grid x:Name="StartScreenContainer" Margin="80,42,80,24">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="StartScreenScale" ScaleX="1.0" ScaleY="1.0"/>
            </Grid.LayoutTransform>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StartScreenTranslate" X="0" Y="0"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА: "Пуск" + amir_ / Питание / Поиск -->
            <Grid Grid.Row="0" Margin="0,0,0,0">
                <TextBlock x:Name="StartTitleTextBlock" Text="Пуск" FontSize="38" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Пользователь -->
                    <Button x:Name="UserButtonControl" Click="UserButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UserNameTextBlock" Text="User" FontSize="18" FontFamily="{StaticResource SegoeRegular}" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="UserAvatarBorder" Width="38" Height="38" Background="#FF555555" CornerRadius="0" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="UserAvatarImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                    <Path x:Name="UserAvatarFallbackIcon" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                          Fill="White" Stretch="Uniform" Width="22" Height="22"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Питание -->
                    <Button x:Name="PowerButtonControl" Click="PowerButton_Click" Width="38" Height="38" Margin="14,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Питание">
                        <Path Data="M16.56,5.44L15.11,6.89C16.84,8.37 18,10.55 18,13A6,6 0 0,1 12,19A6,6 0 0,1 6,13C6,10.55 7.16,8.37 8.89,6.89L7.44,5.44C5.36,7.22 4,9.95 4,13A8,8 0 0,0 12,21A8,8 0 0,0 20,13C20,9.95 18.64,7.22 16.56,5.44M13,3H11V13H13" 
                              Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                    </Button>

                    <!-- Поиск -->
                    <Button Click="SearchCharmToggle_Click" Width="38" Height="38" Margin="14,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Поиск">
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                              Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>

                    <!-- Параметры (Settings Charm - доступен через боковую панель и кнопку шестеренки) -->
                    <Button Click="SettingsCharmToggle_Click" Width="38" Height="38" Margin="14,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Параметры" Visibility="Visible">
                        <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                              Fill="White" Stretch="Uniform" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ИНТЕРАКТИВНАЯ СЕТКА ЖИВЫХ ПЛИТОК И ПОДПИСЕЙ ГРУПП С 3D НАКЛОНОМ -->
            <ScrollViewer x:Name="StartTilesScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,104,0,0" Focusable="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <Canvas x:Name="StartScrollCanvas" Width="2600" Height="1350" Margin="0,0,80,0" VerticalAlignment="Top" ClipToBounds="False">
                    <Canvas x:Name="GroupHeadersCanvas" Width="2600" Height="34" Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="100" ClipToBounds="False"/>
                    <Canvas x:Name="StartTilesCanvas" Width="2600" Height="1300" Canvas.Left="0" Canvas.Top="42" Panel.ZIndex="1" Margin="0" VerticalAlignment="Top" ClipToBounds="False"/>
                </Canvas>
            </ScrollViewer>

            <!-- ЛЕВЫЙ НИЖНИЙ УГОЛ: Переход к «Приложениям» (Идеально круглая и центрированная стрелка) -->
            <Button Grid.Row="2" Style="{StaticResource CircleNavButton}" Margin="0,8,0,8" HorizontalAlignment="Left" Click="NavigateToApps_Click" ToolTip="Приложения">
                <Path Data="M 13.5,17.5 L 20,24 L 26.5,17.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="40" Height="40" RenderOptions.EdgeMode="Unspecified" SnapsToDevicePixels="False"/>
            </Button>
        </Grid>

        <!-- ============================================================== -->
        <!-- 2. ЭКРАН «ПРИЛОЖЕНИЯ» С SEMANTIC ZOOM                         -->
        <!-- ============================================================== -->
        <Grid x:Name="AppsScreenContainer" Margin="80,16,80,8" Visibility="Hidden" Opacity="1">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="AppsScreenScale" ScaleX="1.0" ScaleY="1.0"/>
            </Grid.LayoutTransform>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="AppsScreenTranslate" X="0" Y="1080"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка Приложений: Заголовок + «по имени ∨» + Поиск справа -->
            <Grid Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AppsTitleTextBlock" Text="Приложения" FontSize="40" FontFamily="{StaticResource SegoeLight}" Foreground="White" VerticalAlignment="Center"/>

                    <!-- Плоская кнопка сортировки Metro «по имени ∨» (как в референсе Windows 8.1) -->
                    <Button x:Name="AppsSortButton" Margin="24,10,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="AppsSortButton_Click" FocusVisualStyle="{x:Null}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AppsSortMenu">
                                <MenuItem x:Name="SortByNameItem" Header="по имени" Click="SortOption_Click" IsChecked="True"/>
                                <MenuItem x:Name="SortByDateItem" Header="по дате установки" Click="SortOption_Click"/>
                                <MenuItem x:Name="SortByUsageItem" Header="по частоте" Click="SortOption_Click"/>
                                <MenuItem x:Name="SortByCategoryItem" Header="по категории" Click="SortOption_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentSortTextBlock" Text="по имени" FontSize="16" FontFamily="{StaticResource SegoeRegular}" Foreground="#B0A0C0" VerticalAlignment="Center"/>
                            <TextBlock Text=" ∨" FontSize="12" Foreground="#9080A0" VerticalAlignment="Center" Margin="4,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Поисковая строка в правом верхнем углу (как в референсе Windows 8.1) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="230" Height="30" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                    <Grid>
                        <TextBox x:Name="AppsSearchInput" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="13" FontFamily="{StaticResource SegoeRegular}"
                                 Padding="8,4,30,4" VerticalContentAlignment="Center" TextChanged="AppsSearchInput_TextChanged" CaretBrush="White"/>
                        <TextBlock Text="Поиск" FontSize="13" FontFamily="{StaticResource SegoeRegular}" Foreground="#66FFFFFF"
                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=AppsSearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                              Fill="#AAFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="14" Height="14"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Вертикально-колонный скроллер приложений (Zoomed-In Detail Layer) -->
            <Grid Grid.Row="1" x:Name="ZoomedInAppsLayer" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="AppsZoomInScale" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.RenderTransform>

                <ScrollViewer x:Name="AppsListScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Margin="0,10,0,10" Focusable="False" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" CanContentScroll="False"
                              SizeChanged="AppsListScrollViewer_SizeChanged">
                    <ItemsControl x:Name="AppsWrapItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel x:Name="AppsWrapPanel" Orientation="Vertical" Height="730"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 1. Элемент приложения -->
                                    <Button Width="255" Height="40" Margin="0,1,24,1" Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" HorizontalContentAlignment="Left" FocusVisualStyle="{x:Null}"
                                            Click="AppInventoryItem_Click" ClipToBounds="True"
                                            Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdr" Background="{TemplateBinding Background}" Padding="6,2" SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bdr" Property="Background" Value="#45FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.ContextMenu>
                                            <ContextMenu Background="#FF1B3A57">
                                                <MenuItem Header="Закрепить на начальном экране" Click="PinAppToStart_Click" Foreground="White"/>
                                                <MenuItem Header="Открыть расположение файла" Click="OpenAppLocation_Click" Foreground="White"/>
                                                <MenuItem Header="Удалить" Click="UninstallApp_Click" Foreground="White"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" Background="{Binding TileBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- 1. Настоящая иконка приложения (Metro PNG или значок системы) -->
                                                    <Image Source="{Binding IconImagePath}" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIconImage}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    
                                                    <!-- 2. Запасной текстовый значок (ОТОБРАЖАЕТСЯ ТОЛЬКО ЕСЛИ НЕТ ИЗОБРАЖЕНИЯ ИКОНКИ) -->
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIconImage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontFamily="{StaticResource SegoeRegular}" Foreground="White"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Width="198"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 2. Заголовок секции (Буква или Системная папка) -->
                                    <Grid Width="255" Margin="0,0,24,0" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}">
                                        <!-- Крупная буква (как в референсе Windows 8.1) -->
                                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                HorizontalAlignment="Left" Click="LetterHeader_Click" FocusVisualStyle="{x:Null}"
                                                Visibility="{Binding IsLetterHeader, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding HeaderTitle}" FontSize="25" FontFamily="{StaticResource SegoeLight}"
                                                       Foreground="#E092D8" Padding="6,6,0,0"/>
                                        </Button>

                                        <!-- Название папки / категории (Segoe UI 13px) -->
                                        <TextBlock Text="{Binding HeaderTitle}" FontSize="13" FontFamily="{StaticResource SegoeRegular}"
                                                   Foreground="#D48ED4" Padding="6,12,0,2" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsFolderHeader, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Нижняя панель Приложений: Только круглая стрелка возврата (чистый низ без полосы прокрутки) -->
            <Grid Grid.Row="2" Margin="2,10,0,0">
                <Button Style="{StaticResource CircleNavButton}" HorizontalAlignment="Left" Click="NavigateToStart_Click" ToolTip="Пуск">
                    <Path Data="M 13.5,23.5 L 20,17 L 26.5,23.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="40" Height="40" RenderOptions.EdgeMode="Unspecified" SnapsToDevicePixels="False"/>
                </Button>
            </Grid>

